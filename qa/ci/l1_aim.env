# Package (configurable)
PKG=com.crashverse.game
# BUG-24 primary: per-level shots from levels/ch1/ci_win_shots.json (PR #13), delivered via dev aim hook (dev_aim_cmd.json);
# swipe from the same file if the hook isn't acknowledged. Values below are the fallback when the JSON is absent.
WIN_SHOTS_JSON=levels/ch1/ci_win_shots.json
LEVEL_ID=c1_l01
WIN_GSCALE=1.0
AIM_MODE=hook
WIN_YAW=1.0
WIN_PITCH=11.0
MISS_YAW=1.0
MISS_PITCH=-30
# Age gate: year picked by name; target = current year - YEAR_OFFSET (13+ band)
BIRTH_MONTH=January
YEAR_OFFSET=20
YEAR_MAX_SWIPES=12
# Swipe fallback at 1080x2340 (scaled from CVTAP|META if the screen differs). From ci_win_shots.json c1_l01 shot 1.
L1_WIN_FROM_X=540
L1_WIN_FROM_Y=1300
L1_WIN_TO_X=540
L1_WIN_TO_Y=1549
# Miss: drag down hard (low elevation) into the ground
L1_MISS_TO_X=540
L1_MISS_TO_Y=2200   # ~ -26 deg elevation per ci_win_shots geometry (0.15 deg/dp, 420 dpi)
