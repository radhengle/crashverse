# Package (configurable)
PKG=com.crashverse.game
# BUG-24 primary path: dev aim hook (CRASHVERSE_DEV), writes dev_aim_cmd.json to persistentDataPath.
AIM_MODE=hook
WIN_YAW=1.0
WIN_PITCH=11.0
MISS_YAW=1.0
MISS_PITCH=-30
# Age gate picks (ListModal buttons are Button_<label>)
BIRTH_MONTH=January
BIRTH_YEAR=2006
# Swipe fallback (1080x2340), used only if the hook isn't acknowledged. PLACEHOLDERS until calibrated.
L1_WIN_FROM_X=
L1_WIN_FROM_Y=
L1_WIN_TO_X=
L1_WIN_TO_Y=
L1_MISS_TO_X=
L1_MISS_TO_Y=
