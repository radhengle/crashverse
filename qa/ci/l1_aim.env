# Package (configurable)
PKG=com.crashverse.game
# BUG-24: win aim candidates in order: ci_win_shots.json (PR #13, primary), then chapter1.json hint only if it disagrees.
# Each goes via the dev aim hook; swipe fallback if the hook isn't acknowledged. WIN_* below are used only when neither JSON is present.
CHAPTER_JSON=Assets/_Project/Resources/Data/chapter1.json
WIN_SHOTS_JSON=levels/ch1/ci_win_shots.json
LEVEL_ID=c1_l01
WIN_GSCALE=1.0
AIM_MODE=hook
WIN_YAW=0.0   # LD: L1 win yaw 0.0 / pitch 11.0 (13.0 at gravity x1.2); 1.0 was PR #12's stale hint
WIN_PITCH=11.0
MISS_YAW=1.0
MISS_PITCH=-30
# Age gate: year picked by name; target = current year - YEAR_OFFSET (13+ band)
BIRTH_MONTH=January
YEAR_OFFSET=20
YEAR_MAX_SWIPES=12
# Swipe fallback at 1080x2340 (scaled from CVTAP|META if the screen differs). From ci_win_shots.json c1_l01 shot 1.
L1_WIN_FROM_X=540
L1_WIN_FROM_Y=1300
L1_WIN_TO_X=540
L1_WIN_TO_Y=1549
# Miss: drag down hard (low elevation) into the ground
L1_MISS_TO_X=540
L1_MISS_TO_Y=2200   # ~ -26 deg elevation per ci_win_shots geometry (0.15 deg/dp, 420 dpi)
