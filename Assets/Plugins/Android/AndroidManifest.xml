<?xml version="1.0" encoding="utf-8"?>
<!-- Custom main manifest (Unity 2022.3). Security Admin: the merged manifest must not contain AD_ID.
     tools:node="remove" strips it even if a library (e.g. play-services-ads-identifier) declares it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- APK-04 (#21): no backups (allowBackup/fullBackupContent off; dataExtractionRules exclude everything on Android 12+). -->
  <application android:allowBackup="false"
               android:fullBackupContent="false"
               android:dataExtractionRules="@xml/data_extraction_rules"
               tools:replace="android:allowBackup">
    <activity android:name="com.unity3d.player.UnityPlayerActivity"
              android:theme="@style/UnityThemeSelector"
              android:exported="true"
              android:screenOrientation="portrait"
              android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density|colorMode|fontWeightAdjustment|grammaticalGender"
              tools:replace="android:screenOrientation,android:configChanges">
      <!-- QA V2-01: Unity's own list (0x40003fff) lacks colorMode, fontWeightAdjustment and grammaticalGender (Android 14). A change
           in one of those makes Android recreate the activity, which Unity turns into onDestroy + a self SIGKILL. Handle them all. -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
    </activity>
  </application>
</manifest>
